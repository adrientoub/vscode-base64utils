{
  "name": "base64utils",
  "displayName": "Base64 Utils",
  "description": "Some utilities to edit text from and to base64. Also able to gzip-base64 and gunzip-base64.",
  "version": "1.3.0",
  "publisher": "adrientoub",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrientoub/vscode-base64utils"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.Base64",
        "title": "Base64: Encode"
      },
      {
        "command": "extension.Base64D",
        "title": "Base64: Decode"
      },
      {
        "command": "extension.GzipBase64",
        "title": "Gzip: Base64: Gzip-base64"
      },
      {
        "command": "extension.GunzipBase64",
        "title": "Gzip: Base64: Gunzip-b64"
      },
      {
        "command": "extension.OpenInNewTab",
        "title": "Open selection in new tab"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.Base64"
        },
        {
          "command": "extension.Base64D"
        },
        {
          "command": "extension.GzipBase64"
        },
        {
          "command": "extension.GunzipBase64"
        },
        {
          "command": "extension.OpenInNewTab"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run package-web",
    "compile": "tsc -p ./",
    "lint": "eslint src",
    "format": "prettier --write .",
    "watch": "tsc -watch -p ./",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.0",
    "@types/webpack-env": "^1.18.8",
    "buffer": "^6.0.3",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  }
}
